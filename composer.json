{
  "name": "andre1502/net_utilities",
  "version": "0.3.5",
  "description": "Library to combine common function",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "andre1502"
    }
  ],
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
    "guzzlehttp/guzzle": "^7.8.1",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "lcobucci/clock": "^3.2",
    "lcobucci/jwt": "^4.3 || ^5.3",
    "symfony/http-foundation": "^6.2 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "nunomaduro/collision": "^8.1.1",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "pestphp/pest": "^2.35.0 || ^3.0 || ^4.0 || ^5.0",
    "pestphp/pest-plugin-laravel": "^2.4 || ^3.0 || ^4.0 || ^5.0",
    "phpstan/phpstan": "^1.10 || ^2.0"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest --order-by random",
    "test:standalone": "bash scripts/test-standalone.sh",
    "test:all": [
      "@test",
      "@test:standalone"
    ],
    "verify": [
      "@analyse",
      "@test",
      "@test:standalone"
    ],
    "test-coverage": "vendor/bin/pest --coverage"
  },
  "autoload": {
    "psr-4": {
      "Andre1502\\NetUtilities\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Andre1502\\NetUtilities\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Andre1502\\NetUtilities\\NetUtilitiesProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
